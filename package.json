{
  "name": "notifyflow",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-Style Distributed Notification Backend with PostgreSQL, Redis, BullMQ, WebSockets, and FCM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.cpSync('src/database/migrations', 'dist/database/migrations', { recursive: true, force: true }))\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "tsx src/database/migrator.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx load-tests/benchmark.ts"
  },
  "keywords": [
    "notifications",
    "distributed-systems",
    "bullmq",
    "redis",
    "postgresql",
    "websockets",
    "fcm",
    "outbox-pattern"
  ],
  "author": "Pratima Sahuji",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.14",
    "pg-mem": "^3.0.5",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
