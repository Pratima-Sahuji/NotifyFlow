# Server
NODE_ENV=development
PORT=4000
WS_PORT=4001
LOG_LEVEL=info
ENABLE_SWAGGER=true

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notifyflow
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=notifyflow-super-secret-jwt-key-32chars!
JWT_EXPIRES_IN=7d

# Worker Settings
WORKER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Firebase Cloud Messaging (FCM HTTP v1)
# Either provide full FIREBASE_SERVICE_ACCOUNT JSON or project/credentials
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
USE_MOCK_FCM=true
